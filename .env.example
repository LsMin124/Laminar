# Laminar — 환경변수 예시 (Task 1.7.5)
# 사용: cp .env.example .env  →  값 채우기
# 상세 가이드: Laminar_Phase0_Runbook.md
# ⚠ 실제 .env는 .gitignore 처리됨, 절대 커밋 금지

# ── Neon Postgres (Task 0.2) ──────────────────────────────────
# Neon 콘솔 → Connect → libpq URL을 JDBC 형식으로 변환 (pgjdbc 호환)
#   1) URL은 jdbc:postgresql://host/db?sslmode=require 형식 (channel_binding 제거)
#   2) 인증은 USERNAME·PASSWORD 분리 (pgjdbc는 user:pass@host URL 거부)
DATABASE_URL="jdbc:postgresql://<pooler-host>.neon.tech/neondb?sslmode=require"
DATABASE_URL_DIRECT="jdbc:postgresql://<direct-host>.neon.tech/neondb?sslmode=require"
DATABASE_USERNAME="neondb_owner"
DATABASE_PASSWORD="<neon-password>"

# ── Cloudflare R2 (Task 0.3) ──────────────────────────────────
R2_ACCOUNT_ID="<32자 hex>"
R2_ACCESS_KEY_ID="<32자 hex>"
R2_SECRET_ACCESS_KEY="<64자 hex>"
R2_BUCKET="laminar-prod-attachments"
R2_ENDPOINT="https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com"

# ── Resend (Task 0.4) — 도메인 검증 보류 중 (§12.3.1 v3) ──────
RESEND_API_KEY="re_<rest-of-key>"

# ── Google OAuth (Task 0.5) ───────────────────────────────────
AUTH_GOOGLE_ID="<id>.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="GOCSPX-<secret>"

# ── Sentry (Task 0.6) ─────────────────────────────────────────
SENTRY_DSN="https://<key>@<org>.ingest.<region>.sentry.io/<project>"

# ── 자체 시크릿 (Task 0.7) — openssl rand -base64 32 ──────────
# 생성 스크립트:
#   for k in AUTH_SECRET APP_SECRET_V1 CRON_SECRET SAMPLE_MANAGER_HMAC_SECRET; do
#     v=$(openssl rand -base64 32); sed -i "s|^${k}=.*|${k}=\"${v}\"|" .env
#   done
AUTH_SECRET="<32-byte base64>"
APP_SECRET_V1="<32-byte base64>"
CRON_SECRET="<32-byte base64>"
SAMPLE_MANAGER_HMAC_SECRET="<32-byte base64>"
